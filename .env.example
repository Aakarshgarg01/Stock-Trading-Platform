# ApexTrader Environment Variables Example
# Base URL for REST API (backend Express server)
VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket URL for real-time price updates (Socket.IO)
VITE_WS_URL=http://localhost:5000

# Set to 'true' to use built-in mock services with realistic price simulator
# Set to 'false' to route all API calls to the real backend
VITE_USE_MOCK=true
